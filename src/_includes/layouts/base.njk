<!doctype html>
<html lang="fi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = title if page.url == "/" else (title + " | " + site.title) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description or summary or site.description }}">
  <link rel="canonical" href="{{ baseUrl }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fi_FI">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or summary or site.description }}">
  <meta property="og:url" content="{{ baseUrl }}{{ page.url }}">
  <link rel="icon" href="/uploads/crossedswords-128x128.png" type="image/png">
  {#- Content Security Policy: only this site's own scripts, fonts and styles may load.
      A second line of defence if something unsafe ever ends up in the page content.
      'unsafe-inline' styles are needed for the background images and theme colours. #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="preload" href="/fonts/jost-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <style>:root{ {{ themeVars.css | safe }} }</style>
  {%- if heroImage %}
  {% bgpreload heroImage %}
  {%- elif background and not image %}
  {% bgpreload background %}
  {%- endif %}
  <script src="/js/main.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#sisalto">Siirry sisältöön</a>
  {% include "partials/header.njk" %}
  {%- if draft or (publishAt | isFuture) %}
  {#- Only ever rendered in local preview (npm start); the published build skips these pages. #}
  <p class="preview-banner" role="status">
    {%- if draft %}LUONNOS – tämä sivu ei näy julkisella sivustolla.
    {%- else %}AJASTETTU – julkaistaan {{ publishAt | fiDateTime }}.{% endif %}
  </p>
  {%- endif %}
  <main id="sisalto">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
