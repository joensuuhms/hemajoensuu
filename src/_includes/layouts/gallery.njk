---
layout: layouts/base.njk
---
<section class="section">
  <div class="container">
    <h1 class="page-title title--{{ titleColor or 'light' }}">{{ heroTitle or title }}</h1>
    {%- if content | trim %}<div class="prose">{{ content | safe }}</div>{% endif %}
    {%- if images and images.length %}
    <section class="carousel" aria-roledescription="karuselli" aria-label="Kuvagalleria">
      <div class="carousel__controls">
        <button class="carousel__btn carousel__btn--prev" type="button" data-direction="previous" aria-label="Edellinen kuva">&#8249;</button>
        <button class="carousel__btn carousel__btn--next" type="button" data-direction="next" aria-label="Seuraava kuva">&#8250;</button>
      </div>
      <div class="carousel__track" tabindex="0" role="group" aria-label="Kuvat">
        {%- for img in images %}
        <figure class="carousel__slide" role="group" aria-roledescription="kuva" aria-label="{{ loop.index }} / {{ images.length }}" data-marker-name="Näytä kuva {{ loop.index }}">
          {% image img.src, img.alt, "(min-width: 1140px) 1108px, 100vw", [640, 1108, 1600], ("high" if loop.first else "low") %}
          {%- if img.caption %}<figcaption>{{ img.caption }}</figcaption>{% endif %}
        </figure>
        {%- endfor %}
      </div>
      <p class="visually-hidden" role="status" aria-live="polite"></p>
      <nav class="carousel__dots" aria-label="Valitse kuva"></nav>
    </section>
    {%- endif %}
  </div>
</section>
