---
layout: layouts/base.njk
---
<section class="hero" style="{% bgimage heroImage %}">
  {%- if overlay %}<div class="overlay" style="opacity: {{ overlay }}"></div>{% endif %}
  <div class="container hero__inner">
    <div class="hero__content{% if wide %} hero__content--wide{% endif %}">
      <h1 class="page-title title--{{ titleColor or 'light' }}">{{ heroTitle or title }}</h1>
      <div class="prose">
        {{ content | safe }}
      </div>
      {%- if faq and faq.length %}
      <div class="faq">
        {%- for item in faq %}
        <details class="faq__item">
          <summary class="faq__q">{{ item.question }}</summary>
          <div class="faq__a prose">{{ item.answer | md | safe }}</div>
        </details>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- set buttons = [button, button2] %}
      {%- if (button and button.text) or (button2 and button2.text) %}
      <p class="actions">
        {%- for b in buttons %}{% if b and b.text %}
        <a class="btn btn--{{ b.style or 'accent' }}" href="{{ b.url }}"{% if b.url | isExternal %} target="_blank" rel="noopener"{% endif %}>{{ b.text }}</a>
        {%- endif %}{% endfor %}
      </p>
      {%- endif %}
      {%- if infoBox and infoBox.text %}
      <aside class="info-box" aria-labelledby="info-box-title">
        <h2 class="info-box__title" id="info-box-title">{{ infoBox.title }}</h2>
        <div class="prose">{{ infoBox.text | md | safe }}</div>
      </aside>
      {%- endif %}
    </div>
  </div>
</section>
